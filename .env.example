# Generate with: npm run generate:vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Bearer token agents send to POST /v1/notify
AGENT_API_TOKEN=

# Optional. If set, the PWA must send it as X-Owner-Secret to subscribe or ping.
OWNER_SETUP_SECRET=

# Optional overrides
# SITE_URL=https://your-site.netlify.app
# RATE_LIMIT_PER_HOUR=30

# Personal OS MCP adapter — leave unset. Do not enable in production by default.
# AGENT_NOTIFY_OS_ADAPTER=false
# AGENT_NOTIFY_OS_LIVE_PUSH=false
# AGENT_NOTIFY_OS_BOTS=
# AGENT_NOTIFY_OS_REPLAY_WINDOW_SEC=300
# AGENT_NOTIFY_OS_RATE_LIMIT_PER_HOUR=20
