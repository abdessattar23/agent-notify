# Generate with: npm run generate:vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Bearer token agents send to POST /v1/notify
AGENT_API_TOKEN=

# Optional. If set, the PWA must send it as X-Owner-Secret to subscribe or ping.
OWNER_SETUP_SECRET=

# Optional overrides
# SITE_URL=https://your-site.netlify.app
# RATE_LIMIT_PER_HOUR=30

# Personal OS (preview / local only — placeholders, never production secrets)
# PERSONAL_OS_BOT_TOKENS={"grand-master":"<set-in-netlify-ui>","otel-scout":"<set-in-netlify-ui>"}
# PERSONAL_OS_TOKEN_GRAND_MASTER=<set-in-netlify-ui>
# PERSONAL_OS_RATE_LIMIT_PER_HOUR=60
# PERSONAL_OS_RETENTION_DAYS=90
# PERSONAL_OS_NOTIFY_ENABLED=0
# PERSONAL_OS_ALLOW_SEED=0
# Seed is always blocked on https://agent-notify.netlify.app. Draft/preview
# hostnames (*--agent-notify.netlify.app) may seed when the flag is 1.
