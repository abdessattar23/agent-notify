{
  "name": "agent-notify",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Personal Netlify PWA + API: AI agents POST notifications, owner gets Web Push on iPhone, Android Chrome, and desktop Chromium.",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "tsx server/local.ts",
    "build": "tsc -b && vite build",
    "preview": "PREVIEW=1 tsx server/local.ts",
    "typecheck": "tsc -b && tsc -p tsconfig.functions.json --noEmit",
    "test": "tsx --test shared/*.test.ts netlify/lib/*.test.ts",
    "lint": "oxlint",
    "generate:vapid": "tsx scripts/generate-vapid.ts",
    "generate:icons": "python3 scripts/generate-icons.py"
  },
  "dependencies": {
    "@netlify/blobs": "^10.0.10",
    "@netlify/functions": "^5.1.0",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.544.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "tailwind-merge": "^3.3.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.0",
    "netlify-cli": "^27.5.0",
    "oxlint": "^1.79.0",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2",
    "vite": "^8.2.2"
  }
}
